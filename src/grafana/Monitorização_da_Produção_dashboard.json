          "rawSql": "SELECT\n    (DATE_TRUNC('hour', data_hora) AT TIME ZONE 'Europe/Lisbon') AS time,\n    maquina_id AS metric,\n    SUM(pecas_produzidas) AS value\nFROM eventos_producao\nWHERE data_hora >= '2026-10-15 00:11:00' AND maquina_id IN ($maquina)\nGROUP BY 1, 2\nORDER BY 1;",
          "refId": "A"
        }
