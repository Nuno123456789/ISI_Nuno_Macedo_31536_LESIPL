          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    maquina_id || ' ' || TO_CHAR(data_hora, 'DD/MM') AS \"Máquina / dia\",\n    COUNT(*) FILTER (WHERE estado = 'PRODUCAO')   AS \"Produção\",\n    COUNT(*) FILTER (WHERE estado = 'PARADA')     AS \"Paragem\",\n    COUNT(*) FILTER (WHERE estado = 'MANUTENCAO') AS \"Manutenção\"\nFROM eventos_producao\nWHERE data_hora >= '2026-10-15 00:11:00' AND maquina_id IN ($maquina)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Tempo por estado (minutos): onde se perde a disponibilidade",
      "type": "barchart"
